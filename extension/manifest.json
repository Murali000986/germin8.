{
  "manifest_version": 3,
  "name": "Germin8 – Intelligent Form Automation Engine",
  "version": "2.5.0",
  "description": "Universal AI-assisted form automation platform for MCA e-filing portal (mca.gov.in) and dynamic SPAs.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.mca.gov.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Germin8 Form Automation Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/scanner.js",
        "content/filler.js",
        "content/highlighter.js"
      ],
      "css": [
        "content/highlighter.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/highlighter.css",
        "lib/mca-ontology.js",
        "lib/mapping-engine.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
